# Supabase Configuration
# Get these from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI - required for /chat (fine-tuned poetry models)
OPENAI_API_KEY=sk-your-openai-key-here

# Admin panel - required. /admin, /theme-voting/admin and the admin API all
# fail closed when this is unset (there is no default password).
ADMIN_PASSWORD=pick-something-long
